{
  "name": "AI Job Hunter - Approvals",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Your own address: only replies sent from it count as decisions\nconst MY_ADDRESS = 'your.address@example.com';\n\n// Words that count as an answer (only the first word of the reply is read)\nconst yesWords = ['yes', 'si', 'ok', 'vale'];\nconst noWords = ['no'];\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const message = item.json;\n\n  // Only your own replies count\n  const from = String(message.From || '').toLowerCase();\n  if (!from.includes(MY_ADDRESS)) continue;\n\n  // The first word you typed: lower case, accents and punctuation removed (\"Sí.\" becomes \"si\")\n  const firstWord = String(message.snippet || '')\n    .trim()\n    .split(/\\s+/)[0]\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .replace(/[^a-z]/g, '');\n\n  let decision = '';\n  if (yesWords.includes(firstWord)) decision = 'approved';\n  if (noWords.includes(firstWord)) decision = 'rejected';\n\n  // Anything else is ignored. The preview itself starts with \"Reply\", so it never counts.\n  if (decision === '') continue;\n\n  results.push({ json: { threadId: message.threadId, decision: decision } });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
